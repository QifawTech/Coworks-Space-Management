option_settings:
  # ✅ Single Instance - No Load Balancer (saves ~$16-20/month)
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  # ✅ Point to your WSGI entry point
  aws:elasticbeanstalk:container:python:
    WSGIPath: wsgi:application   # or application:application if renamed

  # ✅ RDS connection - replace with YOUR actual RDS values
  aws:elasticbeanstalk:application:environment:
    DB_HOST: qspace-db.cwl4w2c2s36z.us-east-1.rds.amazonaws.com
    DB_PORT: "3306"
    DB_NAME: mysql
    DB_USER: admin
    DB_PASSWORD: Qspaceco-work
    FLASK_ENV: production
